<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if subtitle %} — {{ subtitle }}{% endif %}</title>
<meta name="description" content="{{ title }}: jogo de texto interativo.">
<style>
  :root {
    --bg: #14110f; --fg: #efe8dc; --dim: #9a8f80; --accent: #e8b04a;
    --card: #1d1915; --border: #3a332b; --err: #ff8a7a;
  }
  @media (prefers-color-scheme: light) {
    :root {
      --bg: #f6f1e7; --fg: #241f19; --dim: #6f6454; --accent: #8a4f00;
      --card: #fffaf0; --border: #d8ccb6; --err: #b3261e;
    }
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font: 19px/1.65 Georgia, "Times New Roman", serif;
    -webkit-text-size-adjust: 100%;
  }
  main { max-width: 44rem; margin: 0 auto; padding: 2.5rem 1rem 6rem; }
  h1.title {
    margin: 0 0 1.5rem; font-size: 1.05rem; font-weight: 600; letter-spacing: .14em;
    text-transform: uppercase; color: var(--accent);
  }
  pre.art {
    margin: 0 0 1.75rem; color: var(--accent); overflow-x: auto;
    font: clamp(9px, 2.7vw, 15px)/1.15 ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
    white-space: pre;
  }
  p { margin: 0 0 1.1rem; white-space: pre-line; overflow-wrap: anywhere; }
  p.pending, p.info, p.debug { color: var(--dim); font-size: .9em; }
  p.pending small { display: block; }
  p.error { color: var(--err); }
  p.prompt { margin-top: 1.5rem; font-weight: 600; }
  p.end { color: var(--dim); margin-top: 2rem; }
  .menu { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: .5rem; }
  button, input {
    font: inherit; color: inherit; background: var(--card);
    border: 1px solid var(--border); border-radius: .5rem;
  }
  button { padding: .65rem .9rem; min-height: 2.75rem; cursor: pointer; text-align: left; }
  button:hover:not(:disabled), button:focus-visible { border-color: var(--accent); outline: none; }
  button:focus-visible, input:focus-visible { box-shadow: 0 0 0 2px var(--accent); }
  button:disabled { cursor: default; opacity: .55; }
  button.chosen { opacity: 1; border-color: var(--accent); }
  button .n { color: var(--accent); margin-right: .6rem; font-variant-numeric: tabular-nums; }
  button.continue { color: var(--accent); }
  .row { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; }
  input[type=text] { padding: .6rem .8rem; min-width: 14rem; flex: 1 1 14rem; }
  noscript { display: block; padding: 2rem 1rem; text-align: center; }
</style>
</head>
<body>
<main id="screen" aria-live="polite"></main>
<noscript>Este jogo precisa de JavaScript.</noscript>

<script id="game-data" type="application/json">{{ data_json|safe }}</script>
<script>
{{ engine_js|safe }}
</script>
<script>
(function () {
  "use strict";
  var data = JSON.parse(document.getElementById("game-data").textContent);
  var screen = document.getElementById("screen");
  var params = new URLSearchParams(location.search);

  // Toda a saída usa textContent: nomes digitados e textos do jogo nunca viram HTML.
  function el(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }
  function reveal(node) {
    if (node.scrollIntoView) node.scrollIntoView({ block: "nearest", behavior: "smooth" });
  }
  function focusLater(node) {
    setTimeout(function () { node.focus({ preventScroll: true }); reveal(node); }, 0);
  }

  // Um único ouvinte de teclado, trocado a cada interação (Enter, números, S/N).
  var onKey = null;
  document.addEventListener("keydown", function (ev) {
    // Um evento já tratado (ex.: Enter no campo de nome) não pode pular a página seguinte.
    if (onKey && !ev.defaultPrevented && !ev.ctrlKey && !ev.metaKey && !ev.altKey) onKey(ev);
  });
  function interaction(setup) {
    return new Promise(function (resolve) {
      setup(function (value) { onKey = null; resolve(value); });
    });
  }

  var ui = {
    clear: function () { screen.replaceChildren(); window.scrollTo(0, 0); },
    banner: function (t) { screen.append(el("h1", "title", t)); },
    art: function (t) {
      var pre = el("pre", "art", t);
      pre.setAttribute("role", "img");
      pre.setAttribute("aria-label", "ilustração em ASCII");
      screen.append(pre);
    },
    text: function (t) {
      t.split(/\n{2,}/).forEach(function (para) { screen.append(el("p", "", para)); });
    },
    pending: function (label, draft) {
      var p = el("p", "pending", "[texto pendente] " + label);
      if (draft) p.append(el("small", "", "rascunho: " + draft));
      screen.append(p);
    },
    info: function (t) { screen.append(el("p", "info", t)); },
    error: function (t) { screen.append(el("p", "error", t)); },
    debug: params.has("debug") ? function (id, kind, label) {
      screen.append(el("p", "debug", "[" + id + " " + kind + "] " + label));
    } : null,
    autoMenu: function (prompt, labels, idx) {
      screen.append(el("p", "info", prompt + "  →  " + labels[idx]));
    },
    autoAsk: function (prompt, ans) { screen.append(el("p", "info", prompt + "  →  " + ans)); },
    end: function () {
      screen.append(el("p", "end", "— Fim —"));
      var b = el("button", "continue", "Jogar de novo");
      b.addEventListener("click", function () { location.reload(); });
      screen.append(b);
      reveal(b);
    },

    waitContinue: function () {
      return interaction(function (done) {
        var b = el("button", "continue", "Continuar ▸");
        screen.append(b);
        focusLater(b);
        function finish() { b.disabled = true; done(); }
        b.addEventListener("click", finish);
        onKey = function (ev) {
          if (ev.key === "Enter" || ev.key === " ") { ev.preventDefault(); finish(); }
        };
      });
    },

    menu: function (prompt, labels) {
      return interaction(function (done) {
        screen.append(el("p", "prompt", prompt));
        var ol = el("ol", "menu");
        var buttons = labels.map(function (label, i) {
          var li = el("li");
          var b = el("button");
          b.append(el("span", "n", String(i + 1)), document.createTextNode(label));
          li.append(b);
          ol.append(li);
          b.addEventListener("click", function () { choose(i); });
          return b;
        });
        screen.append(ol);
        reveal(ol); // sem foco automático: um Enter distraído não escolhe a 1ª opção
        function choose(i) {
          buttons.forEach(function (b) { b.disabled = true; });
          buttons[i].classList.add("chosen");
          done(i);
        }
        onKey = function (ev) {
          var n = parseInt(ev.key, 10);
          if (n >= 1 && n <= Math.min(9, labels.length)) { ev.preventDefault(); choose(n - 1); }
        };
      });
    },

    ask: function (prompt, def) {
      return interaction(function (done) {
        var row = el("div", "row");
        var input = el("input");
        input.type = "text";
        input.autocomplete = "off";
        input.setAttribute("aria-label", prompt);
        if (def) input.placeholder = def;
        var ok = el("button", "continue", "OK ▸");
        screen.append(el("p", "prompt", prompt));
        row.append(input, ok);
        screen.append(row);
        focusLater(input);
        function submit() { input.disabled = ok.disabled = true; done(input.value.trim()); }
        ok.addEventListener("click", submit);
        input.addEventListener("keydown", function (ev) {
          if (ev.key === "Enter") { ev.preventDefault(); ev.stopPropagation(); submit(); }
        });
        onKey = null; // o campo de texto cuida das próprias teclas
      });
    },

    confirmRestart: function () {
      return interaction(function (done) {
        screen.append(el("p", "prompt", "Recomeçar?"));
        var row = el("div", "row");
        var yes = el("button", "", "Sim (S)");
        var no = el("button", "", "Não (N)");
        row.append(yes, no);
        screen.append(row);
        reveal(row);
        function choose(v) { yes.disabled = no.disabled = true; done(v); }
        yes.addEventListener("click", function () { choose(true); });
        no.addEventListener("click", function () { choose(false); });
        onKey = function (ev) {
          var k = ev.key.toLowerCase();
          if (k === "s") { ev.preventDefault(); choose(true); }
          if (k === "n") { ev.preventDefault(); choose(false); }
        };
      });
    }
  };

  // ?seed=N torna os sorteios reprodutíveis; ?auto=1 joga sozinho; ?debug=1 mostra os ids dos nós.
  function mulberry32(a) {
    return function () {
      a |= 0; a = (a + 0x6d2b79f5) | 0;
      var t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  var opts = { auto: params.has("auto") };
  if (params.has("seed")) opts.rng = mulberry32(parseInt(params.get("seed"), 10) || 0);

  createGame(data, ui, opts).play();
})();
</script>
</body>
</html>
